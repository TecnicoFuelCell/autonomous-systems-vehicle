<!-- Launchfile to automatically write the R,t vectors to camera_extrinsics.yaml -->

<launch>
    <node pkg="webcam_pub" exec="camera_info_node" name="camera_info_node" output="screen">
        <param from="config/car_params.yaml"/>
    </node>

    <!-- Add RViz node -->
    <node pkg="rviz2" exec="rviz2" name="rviz2" args="-d resources/sim/debug_slam.rviz" output="screen"/>

    <!-- Camera launch -->
    <node pkg="webcam_pub" exec="webcam_node" name="webcam_publisher" output="screen">
        <param from="config/car_params.yaml"/>
    </node>

    <!-- launch extrinsic calib-->
    <node pkg="utils" exec="calibrate_aruco" name="calibrate_aruco" output="screen">
        <param from="config/car_params.yaml"/>
    </node>

</launch>
