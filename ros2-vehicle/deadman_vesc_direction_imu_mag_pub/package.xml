<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypened="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>deadman_vesc_direction_imu_mag_pub</name>
  <version>0.0.1</version>
  <description>ROS 2 C++ package for joystick actuation, deadman switch, VESC, IMU, and Magnetometer data over UART</description>
  <maintainer email="user@todo.todo">User</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>example_interfaces</depend>
  <depend>yaml-cpp</depend>
  <depend>car_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
