<!-- launch car with joystick-->

<launch>
    <arg name="vehicle_params" default="$(find-pkg-share vehicle_bringup)/config/vehicle_params.yaml"/>
    <node pkg="joy" exec="joy_node" name="joy_node" output="screen">
        <param name="dev" value="/dev/input/js0"/>
        <param name="deadzone" value="0.05"/>
        <param name="autorepeat_rate" value="20.0"/>
    </node>
    
    <node pkg="joystick_pub" exec="joystick_node" name="joystick_reader" output="screen" > 
        <param from="$(var vehicle_params)"/>
    </node>
    
    <!-- UART reader: owns the CANToPC serial device (read-only upstream) and
         republishes each raw sensor line on /serial/* for the decode nodes below. -->
    <node pkg="uart_reader" exec="uart_node" name="uart_node" output="screen">
        <param from="$(var vehicle_params)"/>
    </node>

    <!-- UART writer: subscribes to /joystick_movement (ImSpeed) and writes
         motor/steering commands to the PCToCAN serial device (which translates
         them into CAN frames for the motors). Not gated by /deadman/alive;
         deadman handling is left to the logic that produces the commands. -->
    <node pkg="uart_writer" exec="uart_writer_node" name="uart_writer" output="screen">
        <param from="$(var vehicle_params)"/>
    </node>

    <!-- Deadman watchdog: consumes /serial/deadman ALIVE lines from the reader
         and publishes /deadman/alive (disarms when ALIVE goes stale). -->
    <node pkg="deadman_pub" exec="deadman_node" name="deadman_node" output="screen">
        <param from="$(var vehicle_params)"/>
    </node>

    <!-- Sensor decode nodes: subscribe to raw /serial/* lines from uart_reader
         and publish the typed topics (names unchanged for downstream consumers). -->
    <node pkg="vesc_pub" exec="vesc_node" name="vesc_node" output="screen">
        <param from="$(var vehicle_params)"/>
    </node>
    <node pkg="dir_pub"  exec="dir_node"  name="dir_node"  output="screen">
        <param from="$(var vehicle_params)"/>
    </node>
    <node pkg="imu_pub"  exec="imu_node"  name="imu_node"  output="screen">
        <param from="$(var vehicle_params)"/>
    </node>
    <node pkg="mag_pub"  exec="mag_node"  name="mag_node"  output="screen">
        <param from="$(var vehicle_params)"/>
    </node>

    <node pkg="webcam_pub" exec="webcam_node" name="webcam_publisher" output="screen">
        <param from="$(var vehicle_params)"/>
    </node>
    <node pkg="webcam_pub" exec="camera_info_node" name="camera_info_node" output="screen">
        <param from="$(var vehicle_params)"/>
    </node>

    <node pkg="gps_pub" exec="gps_node" name="gps_node" output="screen">
        <param from="$(var vehicle_params)"/>
    </node>

</launch>