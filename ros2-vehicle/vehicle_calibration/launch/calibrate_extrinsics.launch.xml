<!-- Extrinsic calibration: reads camera_intrinsics_path, writes camera_extrinsics_path (shared section of vehicle_params.yaml). -->

<launch>
    <arg name="vehicle_params" default="$(find-pkg-share vehicle_bringup)/config/vehicle_params.yaml"/>
    <arg name="calibration_params" default="$(find-pkg-share vehicle_calibration)/config/calibration_params.yaml"/>

    <lifecycle_node pkg="webcam_pub" exec="webcam_node" name="webcam_publisher" namespace="" autostart="true" output="screen">
        <param from="$(var vehicle_params)"/>
    </lifecycle_node>

    <node pkg="vehicle_calibration" exec="calibrate_extrinsics" name="calibrate_extrinsics" output="screen">
        <param from="$(var vehicle_params)"/>
        <param from="$(var calibration_params)"/>
    </node>
</launch>
