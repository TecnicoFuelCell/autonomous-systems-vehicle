<!-- Extrinsic calibration: intrinsics from JSON (calibrate_extrinsics.intrinsics_path); writes camera_extrinsics.json. -->

<launch>
    <arg name="vehicle_params" default="$(find-pkg-share vehicle_bringup)/config/vehicle_params.yaml"/>

    <node pkg="webcam_pub" exec="webcam_node" name="webcam_publisher" output="screen">
        <param from="$(var vehicle_params)"/>
    </node>

    <node pkg="vehicle_calibration" exec="calibrate_extrinsics" name="calibrate_extrinsics" output="screen">
        <param from="$(var vehicle_params)"/>
    </node>
</launch>
