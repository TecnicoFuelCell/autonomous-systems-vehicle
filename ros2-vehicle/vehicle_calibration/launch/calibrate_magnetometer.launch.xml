<!-- Magnetometer calibration: mag_node publishes raw /mag_data (no correction
     applied) and calibrate_magnetometer fits hard/soft-iron correction on Ctrl+C, writing
     mag_calib_path (shared section of vehicle_params.yaml). Drive the car slowly
     through full turns on level ground while sampling. -->

<launch>
    <arg name="vehicle_params" default="$(find-pkg-share vehicle_bringup)/config/vehicle_params.yaml"/>
    <arg name="calibration_params" default="$(find-pkg-share vehicle_calibration)/config/calibration_params.yaml"/>

    <!-- CANToPC serial reader: republishes raw lines on /vehicle_internal/serial/*. -->
    <node pkg="uart_reader" exec="uart_node" name="uart_node" output="screen">
        <param from="$(var vehicle_params)"/>
    </node>

    <!-- The fit must see uncorrected data, so the stored calibration is not applied. -->
    <node pkg="mag_pub" exec="mag_node" name="mag_node" output="screen">
        <param from="$(var vehicle_params)"/>
        <param name="apply_mag_calib" value="false"/>
    </node>

    <node pkg="vehicle_calibration" exec="calibrate_magnetometer" name="calibrate_magnetometer" output="screen">
        <param from="$(var vehicle_params)"/>
        <param from="$(var calibration_params)"/>
    </node>
</launch>
