<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypened="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ps4_controller_pub</name>
  <version>0.0.1</version>
  <description>ROS 2 Python package for PS4 DualShock 4 controller to publish ImSpeed on /joystick_movement</description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>car_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>joy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
